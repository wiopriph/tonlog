{
  "name": "tonlog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev --ip 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create tonlog-waitlist",
    "db:migrate:local": "wrangler d1 migrations apply tonlog-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply tonlog-waitlist --remote"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@nuxt/ui": "4.12.0",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
